#!/usr/bin/env bash
# Git pre-commit hook: два «воротарі якості» для staged-змін.
#   1) Gitleaks: блокує коміт, якщо знайдено секрет.
#   2) Radon:    блокує коміт, якщо будь-яка функція/метод у staged .py-файлах
#                має цикломатичну складність CC > 10.
# Підключається командою:  git config core.hooksPath scripts/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

MAX_CC=10
RED=$'\033[1;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

# ---------- 1. Gitleaks ----------
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks не встановлено. Встановлення (macOS): brew install gitleaks" >&2
  exit 1
fi

echo "[pre-commit] Gitleaks: перевірка staged-змін на секрети..."
gitleaks git --pre-commit --staged --redact --verbose --config .gitleaks.toml
echo "[pre-commit] Gitleaks: PASS (секретів у staged-змінах немає)"

# ---------- 2. Complexity gate (Radon) ----------
if [ -x ".venv/bin/python" ]; then PY=".venv/bin/python"; else PY="python3"; fi

if ! "$PY" -m radon --version >/dev/null 2>&1; then
  echo "${RED}[pre-commit] Radon не знайдено. Встановлення: .venv/bin/python -m pip install radon${NC}" >&2
  exit 1
fi

echo "[pre-commit] Radon: перевірка складності staged .py-файлів (ліміт CC <= ${MAX_CC})..."

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' | grep -v '^exp1/' || true)
if [ -z "$FILES" ]; then
  echo "[pre-commit] Radon: staged .py-файлів немає, пропуск"
  exit 0
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

FAIL=0
while IFS= read -r f; do
  mkdir -p "$TMP/$(dirname "$f")"
  git show ":$f" > "$TMP/$f"          # staged-версія файлу, а не робоча копія
  # -n C: показати лише блоки рангу C і гірше (CC >= 11, тобто CC > 10)
  BAD=$("$PY" -m radon cc -n C -s "$TMP/$f" | grep -E ' - [C-F] \(' || true)
  if [ -n "$BAD" ]; then
    echo "${RED}[pre-commit] ЗАБОРОНЕНО: перевищено ліміт CC > ${MAX_CC} у файлі ${f}:${NC}"
    echo "${RED}${BAD}${NC}"
    FAIL=1
  fi
done <<< "$FILES"

if [ "$FAIL" -ne 0 ]; then
  echo "${RED}[pre-commit] Radon: FAIL. Коміт скасовано (Exit Code 1). Спростіть код (напр. Lookup Table).${NC}"
  exit 1
fi

echo "${GREEN}[pre-commit] Radon: PASS (усі функції зі staged-файлів мають CC <= ${MAX_CC})${NC}"
